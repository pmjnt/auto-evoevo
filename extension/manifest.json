{
  "manifest_version": 3,
  "name": "Auto EvoEvo",
  "version": "0.1.0",
  "description": "Auto-signs ADD TO MEMORY transactions on evoevo.ai with guardrails.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://evoevo.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://evoevo.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["https://evoevo.ai/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto EvoEvo"
  },
  "options_page": "options.html"
}
