{
  "manifest_version": 3,
  "name": "Auto EvoEvo",
  "version": "0.2.0",
  "description": "Direct-API automation for EvoEvo memories. Signs locally, broadcasts to 0G — no evoevo.ai tab required.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.evoevo.ai/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto EvoEvo",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html"
}
